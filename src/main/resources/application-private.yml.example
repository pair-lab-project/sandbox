spring:
  datasource:
    url: jdbc:mysql://<host>:<port>/<db-name>?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: <username>
    password: <password>
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: <google-client-id>
            client-secret: <google-client-secret>
          kakao:
            client-id: <kakao-rest-api-key>
            client-secret: <kakao-client-secret>

jwt:
  secret: <32자 이상 랜덤 문자열>
